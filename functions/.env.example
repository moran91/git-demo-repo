# Copy to functions/.env for local emulator use. Never commit real values.
# Region used by callable functions (must match apps/web VITE_FUNCTIONS_REGION).
FUNCTIONS_REGION=me-west1
# Public web origin used in invitation / password-setup links.
APP_ORIGIN=http://localhost:5173
# Optional WhatsApp OTP via Twilio Verify. Leave empty to hide the WhatsApp option entirely.
# Configure as secrets in production: firebase functions:secrets:set TWILIO_ACCOUNT_SID (etc.)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
