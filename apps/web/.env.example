# Copy to apps/web/.env.local for local development. Values are public web config, NOT secrets.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=qareeb-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=qareeb-dev
VITE_FIREBASE_STORAGE_BUCKET=qareeb-dev.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
# Region of the callable functions (must match functions FUNCTIONS_REGION).
VITE_FUNCTIONS_REGION=me-west1
# Set to 1 to connect to the local Emulator Suite.
VITE_USE_EMULATORS=1
# FCM Web Push certificate key pair (Firebase console → Cloud Messaging → Web configuration).
VITE_FCM_VAPID_KEY=
# reCAPTCHA v3 / Enterprise site key for App Check (leave empty to disable App Check).
VITE_APPCHECK_SITE_KEY=
# App Check debug token for local development (never use in production).
VITE_APPCHECK_DEBUG_TOKEN=
